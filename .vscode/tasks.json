{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "github-account-move",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.cursor/github-account-move-check.ps1"
      ],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": {
        "owner": "github-account-move",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*)\\((\\d+),(\\d+)\\): (error|warning): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "close": true,
        "echo": false,
        "showReuseMessage": false
      }
    }
  ]
}
